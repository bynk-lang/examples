suite examples.index {
	-- Copies of the real documents (fetched 2026-10-10): decoding has to cope
	-- with the registry's `$schema` key and the board's extra fields.
	case "the real registry and board decode" {
		expect decodeRegistry(
			Some("{\"$schema\":\"./repos.schema.json\",\"repos\":[{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"description\":\"Deploy action, dry-run fixtures\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"description\":\"Install action: every target, cache, version forms\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"description\":\"CI action: each check against pass/fail fixtures\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"description\":\"Book: chapter listings compile with the diagnostics they quote\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"description\":\"Compat board: collects the canary's results\"}]}")
		).map((r) => r.repos.count()) == Some(5)
		expect decodeBoard(
			Some("{\"runs\":[{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"a9fb863e4d022489aa87748ad9562633517027ad\",\"run_url\":\"https://github.com/bynk-lang/bynk-deploy/actions/runs/37834498762\",\"finished_at\":\"2026-10-08T19:47:43Z\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"99478088c91607125727ef402cb214a5bf7f641b\",\"run_url\":\"https://github.com/bynk-lang/setup-bynk/actions/runs/37834499679\",\"finished_at\":\"2026-10-08T19:47:50Z\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"9fa484ee8b96f4135a8ad91af10dd007bc136d08\",\"run_url\":\"https://github.com/bynk-lang/compat-board/actions/runs/37834500010\",\"finished_at\":\"2026-10-08T19:47:55Z\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"5c8a93d85d690a9854e5bf7ac6e6cd0e341f84b4\",\"run_url\":\"https://github.com/bynk-lang/bynk-ci/actions/runs/37834500590\",\"finished_at\":\"2026-10-08T19:48:10Z\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"f12f879ee5ede9e6460ba31cbc2765f11bb02299\",\"run_url\":\"https://github.com/bynk-lang/architecture-that-compiles/actions/runs/37837712418\",\"finished_at\":\"2026-10-08T20:13:05Z\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"0248a9939a7ef86f75a2a1781b7b1554d8dc9eaa\",\"run_url\":\"https://github.com/bynk-lang/compat-board/actions/runs/38023971081\",\"finished_at\":\"2026-10-10T04:25:13Z\"},{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"a9fb863e4d022489aa87748ad9562633517027ad\",\"run_url\":\"https://github.com/bynk-lang/bynk-deploy/actions/runs/38023970233\",\"finished_at\":\"2026-10-10T04:25:36Z\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"5c8a93d85d690a9854e5bf7ac6e6cd0e341f84b4\",\"run_url\":\"https://github.com/bynk-lang/bynk-ci/actions/runs/38023970629\",\"finished_at\":\"2026-10-10T04:25:52Z\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"99478088c91607125727ef402cb214a5bf7f641b\",\"run_url\":\"https://github.com/bynk-lang/setup-bynk/actions/runs/38023970173\",\"finished_at\":\"2026-10-10T04:26:08Z\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"2c418749b939a50d5ff92c256100bddfaac91dd2\",\"run_url\":\"https://github.com/bynk-lang/architecture-that-compiles/actions/runs/38025145181\",\"finished_at\":\"2026-10-10T04:46:37Z\"}]}")
		).map((b) => b.runs.count()) == Some(10)
	}

	case "a missing or malformed document builds no snapshot" {
		expect build(
			None,
			Some("{\"runs\":[{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"a9fb863e4d022489aa87748ad9562633517027ad\",\"run_url\":\"https://github.com/bynk-lang/bynk-deploy/actions/runs/37834498762\",\"finished_at\":\"2026-10-08T19:47:43Z\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"99478088c91607125727ef402cb214a5bf7f641b\",\"run_url\":\"https://github.com/bynk-lang/setup-bynk/actions/runs/37834499679\",\"finished_at\":\"2026-10-08T19:47:50Z\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"9fa484ee8b96f4135a8ad91af10dd007bc136d08\",\"run_url\":\"https://github.com/bynk-lang/compat-board/actions/runs/37834500010\",\"finished_at\":\"2026-10-08T19:47:55Z\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"5c8a93d85d690a9854e5bf7ac6e6cd0e341f84b4\",\"run_url\":\"https://github.com/bynk-lang/bynk-ci/actions/runs/37834500590\",\"finished_at\":\"2026-10-08T19:48:10Z\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"f12f879ee5ede9e6460ba31cbc2765f11bb02299\",\"run_url\":\"https://github.com/bynk-lang/architecture-that-compiles/actions/runs/37837712418\",\"finished_at\":\"2026-10-08T20:13:05Z\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"0248a9939a7ef86f75a2a1781b7b1554d8dc9eaa\",\"run_url\":\"https://github.com/bynk-lang/compat-board/actions/runs/38023971081\",\"finished_at\":\"2026-10-10T04:25:13Z\"},{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"a9fb863e4d022489aa87748ad9562633517027ad\",\"run_url\":\"https://github.com/bynk-lang/bynk-deploy/actions/runs/38023970233\",\"finished_at\":\"2026-10-10T04:25:36Z\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"5c8a93d85d690a9854e5bf7ac6e6cd0e341f84b4\",\"run_url\":\"https://github.com/bynk-lang/bynk-ci/actions/runs/38023970629\",\"finished_at\":\"2026-10-10T04:25:52Z\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"99478088c91607125727ef402cb214a5bf7f641b\",\"run_url\":\"https://github.com/bynk-lang/setup-bynk/actions/runs/38023970173\",\"finished_at\":\"2026-10-10T04:26:08Z\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"2c418749b939a50d5ff92c256100bddfaac91dd2\",\"run_url\":\"https://github.com/bynk-lang/architecture-that-compiles/actions/runs/38025145181\",\"finished_at\":\"2026-10-10T04:46:37Z\"}]}"),
			0
		).isSome() == false
		expect build(
			Some("{\"$schema\":\"./repos.schema.json\",\"repos\":[{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"description\":\"Deploy action, dry-run fixtures\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"description\":\"Install action: every target, cache, version forms\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"description\":\"CI action: each check against pass/fail fixtures\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"description\":\"Book: chapter listings compile with the diagnostics they quote\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"description\":\"Compat board: collects the canary's results\"}]}"),
			Some("not json"),
			0
		).isSome() == false
		expect build(
			Some("{\"$schema\":\"./repos.schema.json\",\"repos\":[{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"description\":\"Deploy action, dry-run fixtures\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"description\":\"Install action: every target, cache, version forms\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"description\":\"CI action: each check against pass/fail fixtures\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"description\":\"Book: chapter listings compile with the diagnostics they quote\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"description\":\"Compat board: collects the canary's results\"}]}"),
			Some("{\"runs\":[{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"a9fb863e4d022489aa87748ad9562633517027ad\",\"run_url\":\"https://github.com/bynk-lang/bynk-deploy/actions/runs/37834498762\",\"finished_at\":\"2026-10-08T19:47:43Z\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"99478088c91607125727ef402cb214a5bf7f641b\",\"run_url\":\"https://github.com/bynk-lang/setup-bynk/actions/runs/37834499679\",\"finished_at\":\"2026-10-08T19:47:50Z\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"9fa484ee8b96f4135a8ad91af10dd007bc136d08\",\"run_url\":\"https://github.com/bynk-lang/compat-board/actions/runs/37834500010\",\"finished_at\":\"2026-10-08T19:47:55Z\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"5c8a93d85d690a9854e5bf7ac6e6cd0e341f84b4\",\"run_url\":\"https://github.com/bynk-lang/bynk-ci/actions/runs/37834500590\",\"finished_at\":\"2026-10-08T19:48:10Z\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"f12f879ee5ede9e6460ba31cbc2765f11bb02299\",\"run_url\":\"https://github.com/bynk-lang/architecture-that-compiles/actions/runs/37837712418\",\"finished_at\":\"2026-10-08T20:13:05Z\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"0248a9939a7ef86f75a2a1781b7b1554d8dc9eaa\",\"run_url\":\"https://github.com/bynk-lang/compat-board/actions/runs/38023971081\",\"finished_at\":\"2026-10-10T04:25:13Z\"},{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"a9fb863e4d022489aa87748ad9562633517027ad\",\"run_url\":\"https://github.com/bynk-lang/bynk-deploy/actions/runs/38023970233\",\"finished_at\":\"2026-10-10T04:25:36Z\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"5c8a93d85d690a9854e5bf7ac6e6cd0e341f84b4\",\"run_url\":\"https://github.com/bynk-lang/bynk-ci/actions/runs/38023970629\",\"finished_at\":\"2026-10-10T04:25:52Z\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"99478088c91607125727ef402cb214a5bf7f641b\",\"run_url\":\"https://github.com/bynk-lang/setup-bynk/actions/runs/38023970173\",\"finished_at\":\"2026-10-10T04:26:08Z\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"2c418749b939a50d5ff92c256100bddfaac91dd2\",\"run_url\":\"https://github.com/bynk-lang/architecture-that-compiles/actions/runs/38025145181\",\"finished_at\":\"2026-10-10T04:46:37Z\"}]}"),
			0
		).isSome()
	}

	case "the first request fetches both documents, the next one within five minutes neither" {
		stub Sources.download(_) returns each [Some("{\"$schema\":\"./repos.schema.json\",\"repos\":[{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"description\":\"Deploy action, dry-run fixtures\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"description\":\"Install action: every target, cache, version forms\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"description\":\"CI action: each check against pass/fail fixtures\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"description\":\"Book: chapter listings compile with the diagnostics they quote\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"description\":\"Compat board: collects the canary's results\"}]}"), Some("{\"runs\":[{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"a9fb863e4d022489aa87748ad9562633517027ad\",\"run_url\":\"https://github.com/bynk-lang/bynk-deploy/actions/runs/37834498762\",\"finished_at\":\"2026-10-08T19:47:43Z\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"99478088c91607125727ef402cb214a5bf7f641b\",\"run_url\":\"https://github.com/bynk-lang/setup-bynk/actions/runs/37834499679\",\"finished_at\":\"2026-10-08T19:47:50Z\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"9fa484ee8b96f4135a8ad91af10dd007bc136d08\",\"run_url\":\"https://github.com/bynk-lang/compat-board/actions/runs/37834500010\",\"finished_at\":\"2026-10-08T19:47:55Z\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"5c8a93d85d690a9854e5bf7ac6e6cd0e341f84b4\",\"run_url\":\"https://github.com/bynk-lang/bynk-ci/actions/runs/37834500590\",\"finished_at\":\"2026-10-08T19:48:10Z\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"f12f879ee5ede9e6460ba31cbc2765f11bb02299\",\"run_url\":\"https://github.com/bynk-lang/architecture-that-compiles/actions/runs/37837712418\",\"finished_at\":\"2026-10-08T20:13:05Z\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"0248a9939a7ef86f75a2a1781b7b1554d8dc9eaa\",\"run_url\":\"https://github.com/bynk-lang/compat-board/actions/runs/38023971081\",\"finished_at\":\"2026-10-10T04:25:13Z\"},{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"a9fb863e4d022489aa87748ad9562633517027ad\",\"run_url\":\"https://github.com/bynk-lang/bynk-deploy/actions/runs/38023970233\",\"finished_at\":\"2026-10-10T04:25:36Z\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"5c8a93d85d690a9854e5bf7ac6e6cd0e341f84b4\",\"run_url\":\"https://github.com/bynk-lang/bynk-ci/actions/runs/38023970629\",\"finished_at\":\"2026-10-10T04:25:52Z\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"99478088c91607125727ef402cb214a5bf7f641b\",\"run_url\":\"https://github.com/bynk-lang/setup-bynk/actions/runs/38023970173\",\"finished_at\":\"2026-10-10T04:26:08Z\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"2c418749b939a50d5ff92c256100bddfaac91dd2\",\"run_url\":\"https://github.com/bynk-lang/architecture-that-compiles/actions/runs/38025145181\",\"finished_at\":\"2026-10-10T04:46:37Z\"}]}")]
		let first <- api.GET("/examples.json") by Visitor
		let second <- api.GET("/examples.json") by Visitor
		expect first is Ok(_)
		expect second is Ok(_)
		expect Sources.download called 2 times
	}

	case "with nothing reachable and no earlier snapshot, the index is unavailable" {
		stub Sources.download(_) returns None
		let r <- api.GET("/examples.json") by Visitor
		expect r is ServiceUnavailable(_)
	}

	case "the page is served as HTML" {
		stub Sources.download(_) returns each [Some("{\"$schema\":\"./repos.schema.json\",\"repos\":[{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"description\":\"Deploy action, dry-run fixtures\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"description\":\"Install action: every target, cache, version forms\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"description\":\"CI action: each check against pass/fail fixtures\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"description\":\"Book: chapter listings compile with the diagnostics they quote\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"description\":\"Compat board: collects the canary's results\"}]}"), Some("{\"runs\":[{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"a9fb863e4d022489aa87748ad9562633517027ad\",\"run_url\":\"https://github.com/bynk-lang/bynk-deploy/actions/runs/37834498762\",\"finished_at\":\"2026-10-08T19:47:43Z\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"99478088c91607125727ef402cb214a5bf7f641b\",\"run_url\":\"https://github.com/bynk-lang/setup-bynk/actions/runs/37834499679\",\"finished_at\":\"2026-10-08T19:47:50Z\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"9fa484ee8b96f4135a8ad91af10dd007bc136d08\",\"run_url\":\"https://github.com/bynk-lang/compat-board/actions/runs/37834500010\",\"finished_at\":\"2026-10-08T19:47:55Z\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"5c8a93d85d690a9854e5bf7ac6e6cd0e341f84b4\",\"run_url\":\"https://github.com/bynk-lang/bynk-ci/actions/runs/37834500590\",\"finished_at\":\"2026-10-08T19:48:10Z\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"bynk_version\":\"0.313.0\",\"result\":\"pass\",\"commit\":\"f12f879ee5ede9e6460ba31cbc2765f11bb02299\",\"run_url\":\"https://github.com/bynk-lang/architecture-that-compiles/actions/runs/37837712418\",\"finished_at\":\"2026-10-08T20:13:05Z\"},{\"repo\":\"bynk-lang/compat-board\",\"kind\":\"example\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"0248a9939a7ef86f75a2a1781b7b1554d8dc9eaa\",\"run_url\":\"https://github.com/bynk-lang/compat-board/actions/runs/38023971081\",\"finished_at\":\"2026-10-10T04:25:13Z\"},{\"repo\":\"bynk-lang/bynk-deploy\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"a9fb863e4d022489aa87748ad9562633517027ad\",\"run_url\":\"https://github.com/bynk-lang/bynk-deploy/actions/runs/38023970233\",\"finished_at\":\"2026-10-10T04:25:36Z\"},{\"repo\":\"bynk-lang/bynk-ci\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"5c8a93d85d690a9854e5bf7ac6e6cd0e341f84b4\",\"run_url\":\"https://github.com/bynk-lang/bynk-ci/actions/runs/38023970629\",\"finished_at\":\"2026-10-10T04:25:52Z\"},{\"repo\":\"bynk-lang/setup-bynk\",\"kind\":\"action\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"99478088c91607125727ef402cb214a5bf7f641b\",\"run_url\":\"https://github.com/bynk-lang/setup-bynk/actions/runs/38023970173\",\"finished_at\":\"2026-10-10T04:26:08Z\"},{\"repo\":\"bynk-lang/architecture-that-compiles\",\"kind\":\"book\",\"bynk_version\":\"0.314.23\",\"result\":\"pass\",\"commit\":\"2c418749b939a50d5ff92c256100bddfaac91dd2\",\"run_url\":\"https://github.com/bynk-lang/architecture-that-compiles/actions/runs/38025145181\",\"finished_at\":\"2026-10-10T04:46:37Z\"}]}")]
		let r <- api.GET("/") by Visitor
		expect r is Raw(_, _)
	}

	-- One request reads the clock three times: the cache lookup, the snapshot's
	-- timestamp, and the cache write. Ten minutes later the cached snapshot has
	-- expired.
	case "after five minutes the index is fetched again" {
		stub Clock.now() returns each [Instant.fromEpochMillis(0), Instant.fromEpochMillis(0), Instant.fromEpochMillis(0), Instant.fromEpochMillis(600000), Instant.fromEpochMillis(600000), Instant.fromEpochMillis(600000)]
